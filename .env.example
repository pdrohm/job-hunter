# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-from-BotFather
TELEGRAM_CHAT_ID=123456789

WATCH_TECHS=react_native
# linkedin = LinkedIn jobs, linkedin_posts = LinkedIn post search (Mac, logged in)
WATCH_ENGINES=linkedin,linkedin_posts
WATCH_LOCATIONS=Worldwide,Latin America
# Skip jobs located in these countries (posts in Portuguese count as Brazil)
WATCH_EXCLUDE_COUNTRIES=Brazil
# false = only jobs in LATAM or open worldwide / to LATAM (drops UK-only, US-only...)
WATCH_ANY_REGION=false
# true = only US / Canada / Europe companies hiring LATAM, and only real React Native / Expo roles
WATCH_TOP_MARKETS_ONLY=true
# Drop jobs first posted more than N days ago (LinkedIn shows reposts as new)
WATCH_MAX_JOB_AGE_DAYS=7
# true = only contractor / freelance / B2B / PJ
WATCH_CONTRACT_ONLY=false
# false = drop jobs that need US/UK/EU work authorization or visa sponsorship
WATCH_ALLOW_SPONSORSHIP=false
WATCH_TIME_RANGE=24h
WATCH_INTERVAL_MINUTES=120
WATCH_MIN_SCORE=50
WATCH_MAX_PER_RUN=15

# ── Daily bots (daily/morning_brief.py, daily/interview_prep.py). Each is its own @BotFather bot.
MORNING_BOT_TOKEN=
PREP_BOT_TOKEN=
# Google Calendar → Settings → your calendar → "Secret address in iCal format". Comma-separate several.
CALENDAR_ICS_URL=
# Weather (Open-Meteo, no key). Leave empty to skip.
MORNING_LAT=
MORNING_LON=
MORNING_CITY=
MORNING_CURRENCIES=USD-BRL
# Gmail: myaccount.google.com/apppasswords. Leave empty to skip emails.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# MORNING_GMAIL_QUERY=is:unread is:important newer_than:1d -category:promotions -category:social
PREP_LEAD_MINUTES=60
# PREP_KEYWORDS=interview,entrevista,screening,recruiter,recrutador,hiring manager,tech call

# WhatsApp summary (python -m whatsapp_summary.summary). All optional.
# WA_BOT_TOKEN=            # Telegram bot for --telegram (default: TELEGRAM_BOT_TOKEN)
# WA_MY_NAME=             # your name as it shows in groups, so @mentions of you go to "Para você"
# WA_SUMMARY_MODEL=sonnet
# WA_SUMMARY_BUDGET_USD=0.50
# WA_WHISPER_LANG=pt
# WA_DATE_ORDER=dmy        # mdy if your WhatsApp is in US English
# WA_HEADLESS=true
